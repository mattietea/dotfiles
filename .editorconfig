root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.bash]
indent_size = 4

[*.yml]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.properties]
indent_size = 2

[*.toml]
indent_size = 2

[*.ini]
indent_size = 2

[*.sh]
indent_size = 4
